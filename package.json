{
  "name": "jalsuraksha-ne",
  "version": "1.0.1",
  "description": "Smart Community Health Monitoring and Early Warning System for Rural Northeast India",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "npm start",
    "dist": "electron-builder --mac dmg",
    "build:mac": "electron-builder --mac dmg"
  },
  "keywords": [
    "electron",
    "health-monitoring",
    "northeast-india",
    "water-quality",
    "early-warning"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/ashmitsahu1812/desk_appli.git"
  },
  "author": "Ashmit Sahu",
  "license": "MIT",
  "devDependencies": {
    "electron": "^30.0.0",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "com.jalsuraksha.app",
    "productName": "JalSuraksha-NE",
    "directories": {
      "output": "dist"
    },
    "mac": {
      "category": "public.app-category.medical-tech",
      "target": [
        "dmg"
      ],
      "hardenedRuntime": false,
      "gatekeeperAssess": false
    },
    "dmg": {
      "title": "JalSuraksha-NE",
      "contents": [
        {
          "x": 130,
          "y": 220
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "files": [
      "main.js",
      "preload.js",
      "renderer.js",
      "database.js",
      "index.html",
      "package.json"
    ]
  }
}
